# Copy to .env.local and fill in. Never commit .env.local.
# None of these may start with NEXT_PUBLIC_: that prefix copies the value
# into browser JavaScript, where anyone can read it.

# Where the Python API runs (used by server actions and the /api/backend proxy)
BACKEND_URL=http://127.0.0.1:8000

# Used for the Intelligence Query page and chat. The simulator does not need it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional backup if OpenAI fails
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
